# Copy this file to ".env" and fill in your key.
#   cp .env.example .env      (Windows:  copy .env.example .env)
#
# .env is git-ignored. Nothing in it ever reaches the repository, and the key
# stays in the server process — it is never sent to the browser.
#
# Without a key the app still works: the chat answers from its built-in rules
# and says so on screen.

# Your key. Any provider speaking the OpenAI chat-completions shape works.
AI_API_KEY=

# Where to send the request.
#   Groq      https://api.groq.com/openai/v1/chat/completions   (keys start gsk_)
#   xAI       https://api.x.ai/v1/chat/completions              (keys start xai-)
#   OpenAI    https://api.openai.com/v1/chat/completions        (keys start sk-)
#   Ollama    http://localhost:11434/v1/chat/completions        (no key needed)
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Model name. If it is wrong, the provider's own error says so, word for word.
#
# Tested on Groq's free tier:
#   openai/gpt-oss-120b   BEST — clear plain answers, ~3-7s          <-- default
#   groq/compound         also good, slightly more mechanical
#   groq/compound-mini    faster, sometimes cuts off mid-sentence
#   openai/gpt-oss-20b    AVOID — returns reasoning only, no answer
#   qwen/qwen3.6-27b      AVOID — pastes its <think> notes into the reply
AI_MODEL=openai/gpt-oss-120b

# Port for the local server.
PORT=8010
