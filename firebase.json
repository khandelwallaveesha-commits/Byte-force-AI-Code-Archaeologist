{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "app.yaml",
      ".gcloudignore",
      "server.py",
      "DEPLOY.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
