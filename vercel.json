{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/ask.py": { "maxDuration": 60 }
  },

  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)\\.(js|css|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
